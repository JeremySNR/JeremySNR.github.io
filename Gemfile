# This file is ONLY needed if you want to preview the site locally.
# GitHub Pages builds the site server-side without it, so you can ignore
# this entirely unless you install Ruby.
#
# To preview locally (needs Ruby + Bundler):
#   bundle install
#   bundle exec jekyll serve
# then open http://127.0.0.1:4000

source "https://rubygems.org"

gem "github-pages", group: :jekyll_plugins
gem "webrick"

group :jekyll_plugins do
  gem "jekyll-feed"
  gem "jekyll-seo-tag"
  gem "jekyll-sitemap"
end
